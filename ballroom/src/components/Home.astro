---
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Artists from './Artists.astro';
import Devices from './Devices.astro';
import Programme from './Programme.astro';
import Gallery from './Gallery.astro';
import Partners from './Partners.astro';
import Values from './Values.astro';
import Tickets from './Tickets.astro';
import Footer from './Footer.astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<Header t={t} />
<main>
  <Hero t={t} />
  <About t={t} />
  <Artists t={t} />
  <Devices t={t} />
  <Programme t={t} />
  <Gallery t={t} />
  <Partners t={t} />
  <Values t={t} />
  <Tickets t={t} />
</main>
<Footer t={t} />
