---
import { languages } from '../i18n';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav class="lang-switch" aria-label="Langue / Sprache / Taal / Language">
  {
    languages.map((l) => (
      <a
        href={l.path}
        lang={l.code}
        hreflang={l.code}
        aria-current={l.code === current ? 'page' : undefined}
        aria-label={l.name}
        title={l.name}
      >
        {l.label}
      </a>
    ))
  }
</nav>
