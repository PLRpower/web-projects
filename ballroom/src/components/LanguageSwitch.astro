---
import { languages } from '../i18n';

interface Props {
  current: string;
}

const { current } = Astro.props;

/**
 * Drapeaux SVG inline — obligatoire : les emojis drapeaux (🇫🇷…)
 * ne s'affichent pas sous Windows, ils rendent en paires de lettres.
 */
const flags: Record<string, string> = {
  fr: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="13" viewBox="0 0 3 2" aria-hidden="true"><path fill="#0055A4" d="M0 0h3v2H0z"/><path fill="#fff" d="M1 0h1v2H1z"/><path fill="#EF4135" d="M2 0h1v2H2z"/></svg>',
  de: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="13" viewBox="0 0 5 3" aria-hidden="true"><path d="M0 0h5v3H0z"/><path fill="#D00" d="M0 1h5v2H0z"/><path fill="#FFCE00" d="M0 2h5v1H0z"/></svg>',
  nl: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="13" viewBox="0 0 3 2" aria-hidden="true"><path fill="#AE1C28" d="M0 0h3v2H0z"/><path fill="#fff" d="M0 .667h3v.666H0z"/><path fill="#21468B" d="M0 1.333h3v.667H0z"/></svg>',
  en: '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="13" viewBox="0 0 60 30" aria-hidden="true"><clipPath id="uk-cross"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-cross)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></svg>',
};
---

<nav class="lang-switch" aria-label="Langue / Sprache / Taal / Language">
  {
    languages.map((l) => (
      <a
        href={l.path}
        lang={l.code}
        hreflang={l.code}
        aria-current={l.code === current ? 'page' : undefined}
        aria-label={l.name}
        title={l.name}
      >
        <span class="lang-flag" set:html={flags[l.code]} />
      </a>
    ))
  }
</nav>
