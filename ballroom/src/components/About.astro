---
import { Image } from 'astro:assets';
import stageWide from '../assets/gallery/ballroom-03.jpg';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section" id="manifesto">
  <div class="container">
    <div class="editorial-split">
      <aside class="editorial-aside" data-reveal>
        <div class="section-marker">
          <span class="section-num">{t.manifesto.index}</span>
          <span class="eyebrow">{t.manifesto.eyebrow}</span>
        </div>
        <h2 class="section-title">{t.manifesto.title}</h2>

        <div class="manifesto-note">
          <h3>{t.manifesto.identityTitle}</h3>
          <p>{t.manifesto.identity}</p>
        </div>
      </aside>

      <div class="editorial-main">
        <p class="manifesto-lead" data-reveal>{t.manifesto.lead}</p>
        <p class="manifesto-body" data-reveal>{t.manifesto.body}</p>

        <div class="pillars-block" data-reveal>
          <p class="sub-label">{t.manifesto.pillarsTitle}</p>
          <ol class="pillars-list">
            {
              t.manifesto.pillars.map((p) => (
                <li>
                  <span class="pillar-num">{p.num}</span>
                  <div class="pillar-copy">
                    <h3>{p.name}</h3>
                    <p>{p.desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <figure class="editorial-plate" data-reveal>
      <div class="editorial-plate-frame">
        <Image
          src={stageWide}
          alt={t.manifesto.photoAlt}
          widths={[640, 1000, 1400]}
          sizes="(min-width: 1240px) 1200px, 94vw"
          format="webp"
        />
      </div>
      <figcaption>{t.manifesto.photoCaption}</figcaption>
    </figure>
  </div>
</section>
