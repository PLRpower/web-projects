---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="mirrorball-fixture">
  <span class="mirrorball-mount" aria-hidden="true"></span>
  <span class="mirrorball-wire" aria-hidden="true"></span>
  <button
    type="button"
    class="mirrorball-trigger"
    aria-label={label}
    title={label}
    data-mirrorball
  >
    <canvas class="mirrorball-canvas" width="336" height="336" aria-hidden="true"></canvas>
  </button>
</div>

<script>
  interface Facet {
    lat: number;
    lon: number;
    dLat: number;
    dLon: number;
    jLat: number;
    jLon: number;
    tint: number;
  }

  interface Flare {
    x: number;
    y: number;
    size: number;
    alpha: number;
  }

  const initMirrorBalls = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mirrorball]');
    if (!buttons.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rows = 13;
    const facets: Facet[] = [];

    const hash = (a: number, b: number) => {
      const s = Math.sin(a * 127.1 + b * 311.7) * 43758.5453;
      return s - Math.floor(s);
    };

    for (let r = 0; r < rows; r++) {
      const lat0 = -Math.PI * 0.485 + (r / rows) * Math.PI * 0.97;
      const lat1 = -Math.PI * 0.485 + ((r + 1) / rows) * Math.PI * 0.97;
      const lat = (lat0 + lat1) * 0.5;
      const cols = Math.max(7, Math.round(26 * Math.cos(lat)));
      const dLon = (Math.PI * 2) / cols;
      for (let c = 0; c < cols; c++) {
        const lon = (c + 0.5) * dLon;
        facets.push({
          lat,
          lon,
          dLat: (lat1 - lat0) * 0.44,
          dLon: dLon * 0.44,
          jLat: (hash(r, c) - 0.5) * 0.16,
          jLon: (hash(c + 19, r + 7) - 0.5) * 0.16,
          tint: hash(r + 3, c + 11),
        });
      }
    }

    const tiltX = 0.18;
    const tiltZ = 0.22;
    const cxT = Math.cos(tiltX);
    const sxT = Math.sin(tiltX);
    const czT = Math.cos(tiltZ);
    const szT = Math.sin(tiltZ);

    const light = { x: -0.46, y: 0.56, z: 0.69 };
    const half = { x: -0.46, y: 0.56, z: 1.69 };
    const hLen = Math.hypot(half.x, half.y, half.z);
    half.x /= hLen;
    half.y /= hLen;
    half.z /= hLen;

    const rotatePoint = (lat: number, lon: number) => {
      const cl = Math.cos(lat);
      const x0 = cl * Math.sin(lon);
      const y0 = Math.sin(lat);
      const z0 = cl * Math.cos(lon);

      const y1 = y0 * cxT - z0 * sxT;
      const z1 = y0 * sxT + z0 * cxT;

      const x2 = x0 * czT - y1 * szT;
      const y2 = x0 * szT + y1 * czT;

      return { x: x2, y: y2, z: z1 };
    };

    const drawStar = (ctx: CanvasRenderingContext2D, x: number, y: number, r: number, alpha: number) => {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = alpha;

      const halo = ctx.createRadialGradient(0, 0, 0, 0, 0, r * 1.15);
      halo.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
      halo.addColorStop(0.45, 'rgba(244, 236, 222, 0.45)');
      halo.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(0, 0, r * 1.15, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      const inner = r * 0.14;
      ctx.moveTo(0, -r);
      ctx.lineTo(inner, -inner);
      ctx.lineTo(r, 0);
      ctx.lineTo(inner, inner);
      ctx.lineTo(0, r);
      ctx.lineTo(-inner, inner);
      ctx.lineTo(-r, 0);
      ctx.lineTo(-inner, -inner);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = 'rgba(130, 122, 108, 0.35)';
      ctx.lineWidth = 0.65;
      ctx.stroke();
      ctx.restore();
    };

    buttons.forEach((btn) => {
      const canvas = btn.querySelector<HTMLCanvasElement>('.mirrorball-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let phase = 0.65;
      let boostVel = 0;
      let inView = true;
      const baseVel = 0.009;

      const render = () => {
        const w = canvas.width;
        const h = canvas.height;
        const cx = w * 0.5;
        const cy = h * 0.5;
        const R = w * 0.31;

        ctx.clearRect(0, 0, w, h);

        // Soft caustic halo & drifting mirror beams behind the sphere
        const aura = ctx.createRadialGradient(cx, cy, R * 0.35, cx, cy, R * 1.62);
        aura.addColorStop(0, 'rgba(255, 255, 255, 0.96)');
        aura.addColorStop(0.55, 'rgba(255, 252, 245, 0.58)');
        aura.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = aura;
        ctx.beginPath();
        ctx.arc(cx, cy, R * 1.62, 0, Math.PI * 2);
        ctx.fill();

        const rays = 9;
        for (let i = 0; i < rays; i++) {
          const angle = phase * 0.42 + (i * Math.PI * 2) / rays;
          const beamLen = R * (1.52 + 0.16 * Math.sin(phase * 1.3 + i * 1.7));
          const spread = 0.13;
          ctx.save();
          ctx.translate(cx, cy);
          ctx.rotate(angle);
          const rg = ctx.createLinearGradient(R * 0.65, 0, beamLen, 0);
          rg.addColorStop(0, 'rgba(255, 255, 255, 0.85)');
          rg.addColorStop(0.5, 'rgba(255, 253, 248, 0.36)');
          rg.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = rg;
          ctx.beginPath();
          ctx.moveTo(R * 0.55, 0);
          ctx.lineTo(beamLen, -Math.tan(spread) * beamLen);
          ctx.lineTo(beamLen, Math.tan(spread) * beamLen);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        // Grout metallic under-sphere so crisp mortar seams frame every white tile
        const under = ctx.createRadialGradient(cx - R * 0.32, cy - R * 0.34, R * 0.08, cx, cy, R);
        under.addColorStop(0, '#B5AEA2');
        under.addColorStop(0.55, '#867F74');
        under.addColorStop(1, '#4C4841');
        ctx.fillStyle = under;
        ctx.beginPath();
        ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.fill();

        const flares: Flare[] = [];

        for (let i = 0; i < facets.length; i++) {
          const f = facets[i];
          const cP = rotatePoint(f.lat, f.lon + phase);
          if (cP.z < -0.02) continue;

          const p0 = rotatePoint(f.lat - f.dLat, f.lon - f.dLon + phase);
          const p1 = rotatePoint(f.lat - f.dLat, f.lon + f.dLon + phase);
          const p2 = rotatePoint(f.lat + f.dLat, f.lon + f.dLon + phase);
          const p3 = rotatePoint(f.lat + f.dLat, f.lon - f.dLon + phase);

          const nP = rotatePoint(f.lat + f.jLat, f.lon + f.jLon + phase);
          const ndotl = Math.max(0, nP.x * light.x + nP.y * light.y + nP.z * light.z);
          const ndoth = Math.max(0, nP.x * half.x + nP.y * half.y + nP.z * half.z);
          const spec = Math.pow(ndoth, 13);

          const fresnelRim = Math.min(1, Math.max(0, (cP.z + 0.04) / 0.96));
          const envLight = 0.36 + 0.64 * Math.pow(fresnelRim, 0.55);
          const tileReflect = (0.34 + 0.66 * ndotl) * envLight + spec * 0.88 + f.tint * 0.08;
          const v = Math.min(1, tileReflect);

          // Crisp white-pearl-champagne palette calibrated against #FAF9F6 alabaster
          let rCol: number;
          let gCol: number;
          let bCol: number;
          if (v > 0.78) {
            const k = (v - 0.78) / 0.22;
            rCol = Math.round(238 + k * 17);
            gCol = Math.round(233 + k * 22);
            bCol = Math.round(223 + k * 32);
          } else {
            const base = 112 + v * 160;
            const warm = f.tint > 0.55 ? 7 : -2;
            rCol = Math.min(242, Math.round(base + warm));
            gCol = Math.min(238, Math.round(base + warm * 0.5));
            bCol = Math.min(234, Math.round(base - warm * 0.4));
          }

          ctx.fillStyle = `rgb(${rCol},${gCol},${bCol})`;
          ctx.beginPath();
          ctx.moveTo(cx + p0.x * R, cy - p0.y * R);
          ctx.lineTo(cx + p1.x * R, cy - p1.y * R);
          ctx.lineTo(cx + p2.x * R, cy - p2.y * R);
          ctx.lineTo(cx + p3.x * R, cy - p3.y * R);
          ctx.closePath();
          ctx.fill();

          if (spec > 0.42 && cP.z > 0.12 && flares.length < 9) {
            flares.push({
              x: cx + cP.x * R,
              y: cy - cP.y * R,
              size: R * (0.18 + (spec - 0.42) * 0.48),
              alpha: Math.min(1, 0.65 + (spec - 0.42) * 1.15),
            });
          }
        }

        // Crisp hairline rim uniting mirrorball with Swiss border discipline
        ctx.strokeStyle = 'rgba(18, 18, 17, 0.24)';
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.stroke();

        // Top swivel loop collar
        ctx.fillStyle = '#3F3D38';
        ctx.fillRect(cx - 5, cy - R - 4, 10, 4);

        for (let i = 0; i < flares.length; i++) {
          const fl = flares[i];
          drawStar(ctx, fl.x, fl.y, fl.size, fl.alpha);
        }
      };

      render();
      if (reducedMotion) return;

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            inView = entries[0]?.isIntersecting ?? true;
          },
          { threshold: 0.01 },
        );
        io.observe(btn);
      }

      const tick = () => {
        if (!document.hidden && inView) {
          phase += baseVel + boostVel;
          boostVel *= 0.96;
          if (boostVel < 0.0005) boostVel = 0;
          render();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      const triggerBurst = () => {
        boostVel = Math.min(0.22, boostVel + 0.11);
        const rect = canvas.getBoundingClientRect();
        window.dispatchEvent(
          new CustomEvent('ballroom:sparkburst', {
            detail: {
              x: rect.left + rect.width * 0.5,
              y: rect.top + rect.height * 0.5,
              count: 26,
              spread: 95,
            },
          }),
        );
      };

      btn.addEventListener('click', triggerBurst);
      btn.addEventListener('pointerenter', () => {
        boostVel = Math.max(boostVel, 0.045);
      });
    });
  };

  initMirrorBalls();
</script>
