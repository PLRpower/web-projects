---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section" id="devices">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.devices.eyebrow}</p>
      <h2 class="section-title">{t.devices.title}</h2>
    </div>

    <div class="devices-grid">
      {t.devices.items.map((d) => (
        <article class="device-card">
          <div class="device-meta">
            <span class="chip chip-time">{d.time}</span>
            <span class="chip chip-price">{d.price}</span>
          </div>
          <h3>{d.name}</h3>
          <p class="device-tagline">{d.tagline}</p>
          <p class="device-desc">{d.desc}</p>
          <ul class="device-features">
            {d.features.map((f) => <li>{f}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
