---
import { Image } from 'astro:assets';
import viniiPoster from '../assets/artists/vinii-revlon.png';
import boPoster from '../assets/artists/bo-the-qu-ing.png';
import viviPoster from '../assets/artists/vivi-gorgeous-gucci.png';
import toshiroPoster from '../assets/artists/toshiro-kamara.png';
import bodyPoster from '../assets/artists/body-kennedy.png';
import tonyPoster from '../assets/artists/tony-revlon.png';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

const initials = (name: string) => {
  const clean = name.replace(/["«»]/g, '').trim();
  const words = clean.split(/\s+/);
  if (words.length >= 2) {
    return (words[0][0] + words[words.length - 1][0]).toUpperCase();
  }
  return clean.slice(0, 2).toUpperCase();
};

const artists = [
  { ...t.artists.vini, photo: viniiPoster },
  { ...t.artists.bo, photo: boPoster },
  { ...t.artists.vivi, photo: viviPoster },
  { ...t.artists.toshiro, photo: toshiroPoster },
  { ...t.artists.body, photo: bodyPoster },
  { ...t.artists.tony, photo: tonyPoster },
];
---

<section class="section" id="artists">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.artists.eyebrow}</p>
      <h2 class="section-title">{t.artists.title}</h2>
    </div>

    <div class="artists-grid">
      {
        artists.map((artist) => (
          <article class="artist-card artist-card--featured">
            <figure class="artist-photo artist-photo--landscape">
              <Image src={artist.photo} alt={artist.photoAlt} width={840} format="webp" />
            </figure>
            <div class="artist-top">
              <div class="monogram" aria-hidden="true">
                {initials(artist.name)}
              </div>
              <div>
                <h3>{artist.name}</h3>
                <span class="artist-role">{artist.role}</span>
              </div>
            </div>
            <ul class="credits">
              {artist.credits.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </article>
        ))
      }

      <p class="judges-note">{t.artists.judges}</p>
    </div>
  </div>
</section>
