---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section band-tinted" id="lineup">
  <div class="container">
    <div class="section-header-row" data-reveal>
      <div>
        <div class="section-marker">
          <span class="section-num">{t.lineup.index}</span>
          <span class="eyebrow">{t.lineup.eyebrow}</span>
        </div>
        <h2 class="section-title">{t.lineup.title}</h2>
      </div>
      <p class="section-subtitle">{t.lineup.lead}</p>
    </div>

    <div class="lineup-grid" data-reveal>
      {
        t.lineup.slots.map((slot) => (
          <article class="lineup-cell">
            <div class="lineup-top">
              <span class="lineup-code">{slot.code}</span>
              <span class="status-tag">{slot.status}</span>
            </div>
            <h3>{slot.role}</h3>
            <p>{slot.note}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
