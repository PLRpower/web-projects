---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section" id="values">
  <div class="container">
    <div class="editorial-split">
      <div class="editorial-aside" data-reveal>
        <div class="section-marker">
          <span class="section-num">{t.values.index}</span>
          <span class="eyebrow">{t.values.eyebrow}</span>
        </div>
        <h2 class="section-title">{t.values.title}</h2>
        <blockquote class="editorial-quote">{t.values.quote}</blockquote>
      </div>

      <ol class="values-list" data-reveal>
        {
          t.values.items.map((v, i) => (
            <li>
              <span class="value-num">0{i + 1}</span>
              <div>
                <h3>{v.title}</h3>
                <p>{v.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
