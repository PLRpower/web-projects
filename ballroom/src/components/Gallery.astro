---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

/** Photos de scène, chargées depuis src/assets/gallery et triées par nom. */
const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const last = photos.length;
---

<section class="section gallery-section" id="gallery">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.gallery.eyebrow}</p>
      <h2 class="section-title">{t.gallery.title}</h2>
      <p class="section-subtitle">{t.gallery.subtitle}</p>
    </div>

    <div class="gallery-masonry">
      {
        photos.map((photo, i) => (
          <a class="gallery-item" href={`#photo-${i + 1}`} aria-label={`${t.gallery.altPrefix} ${i + 1}`}>
            <Image
              src={photo}
              alt={`${t.gallery.altPrefix} ${i + 1}`}
              widths={[360, 560, 760]}
              sizes="(min-width: 1120px) 346px, (min-width: 700px) 45vw, 46vw"
              format="webp"
            />
          </a>
        ))
      }
    </div>
  </div>

  {
    photos.map((photo, i) => {
      const prev = i === 0 ? last : i;
      const next = i === last - 1 ? 1 : i + 2;
      return (
        <div class="lightbox" id={`photo-${i + 1}`} role="dialog" aria-label={`${t.gallery.altPrefix} ${i + 1}`}>
          <a class="lightbox-close" href="#gallery" aria-label={t.gallery.close}>
            ×
          </a>
          <a class="lightbox-nav lightbox-prev" href={`#photo-${prev}`} aria-label={t.gallery.previous}>
            ‹
          </a>
          <Image
            class="lightbox-img"
            src={photo}
            alt={`${t.gallery.altPrefix} ${i + 1}`}
            widths={[960, 1280]}
            sizes="(min-width: 1300px) 1200px, 92vw"
            format="webp"
          />
          <a class="lightbox-nav lightbox-next" href={`#photo-${next}`} aria-label={t.gallery.next}>
            ›
          </a>
        </div>
      );
    })
  }
</section>
