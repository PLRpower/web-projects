---
import { Image } from 'astro:assets';
import heroPlate from '../assets/gallery/ballroom-04.jpg';
import MirrorBall from './MirrorBall.astro';
import { TICKET_URL, type Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero-caustics" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-kicker-bar">
      <p class="hero-kicker"><span class="kicker-star" aria-hidden="true">✦</span> {t.hero.kicker}</p>
      <span class="hero-location">{t.hero.location}</span>
    </div>

    <div class="hero-canvas-wrap">
      <MirrorBall label={t.hero.mirrorballLabel} />

      <div class="hero-grid">
        <div class="hero-content">
          <h1 class="hero-title">
            <span class="hero-title-pre">
              {t.hero.titlePre}<span class="title-spark" aria-hidden="true">✦</span>
            </span>
            <span class="hero-title-main">{t.hero.titleMain}</span>
          </h1>

          <p class="hero-byline">
            <span class="byline-dot" aria-hidden="true"></span>
            <span>{t.hero.byline}</span>
          </p>

          <p class="hero-tagline">{t.hero.tagline}</p>

          <dl class="hero-meta">
            {
              t.hero.meta.map((item) => (
                <div class="hero-meta-cell">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="hero-cta">
            <a href={TICKET_URL} class="btn btn-ink" target="_blank" rel="noopener noreferrer">
              {t.hero.ctaPrimary} ↗
            </a>
            <a href="#manifesto" class="btn btn-line">{t.hero.ctaSecondary}</a>
          </div>
        </div>

        <figure class="hero-plate">
          <div class="hero-plate-frame">
            <Image
              src={heroPlate}
              alt={t.hero.plateAlt}
              widths={[540, 840, 1200]}
              sizes="(min-width: 960px) 40vw, 94vw"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption>{t.hero.plateCaption}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
