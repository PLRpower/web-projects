---
import { SOCIAL_LINKS, TICKET_URL, type Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section" id="tickets">
  <div class="container">
    <div class="tickets-frame" data-reveal>
      <div class="tickets-primary">
        <div class="section-marker">
          <span class="section-num">{t.tickets.index}</span>
          <span class="eyebrow">{t.tickets.eyebrow}</span>
        </div>
        <h2 class="section-title">{t.tickets.title}</h2>
        <p class="status-tag status-tag--large status-tag--crimson">{t.tickets.status}</p>
        <p class="tickets-lead">{t.tickets.lead}</p>

        <dl class="tickets-specs">
          {
            t.tickets.specs.map((s) => (
              <div class="tickets-spec-row">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="tickets-channels">
        <p class="sub-label">{t.tickets.channelsLabel}</p>
        <p class="tickets-channels-note">{t.tickets.channelsNote}</p>
        <div class="tickets-actions">
          <a href={TICKET_URL} class="btn btn-ink btn-ticket" target="_blank" rel="noopener noreferrer">
            {t.tickets.ctaTicket} ↗
          </a>
          <div class="tickets-socials">
            <a href={SOCIAL_LINKS.instagram} class="btn btn-line btn-sm" target="_blank" rel="noopener noreferrer">
              {t.tickets.ctaInstagram} ↗
            </a>
            <a href={SOCIAL_LINKS.facebook} class="btn btn-line btn-sm" target="_blank" rel="noopener noreferrer">
              {t.tickets.ctaFacebook} ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
