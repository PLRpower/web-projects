---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { SOCIAL_LINKS, TICKET_URL } from '../i18n';

const photoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/redball/*.jpg', {
  eager: true,
});

const rawPhotos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const photos = await Promise.all(
  rawPhotos.map(async (src, index) => {
    const full = await getImage({ src, width: 1280, format: 'webp' });
    return {
      src,
      fullSrc: full.src,
      num: index + 1,
    };
  })
);

const videoModules = import.meta.glob<string>('../assets/redball/*.mp4', {
  eager: true,
  import: 'default',
});

const videos = Object.entries(videoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, url], index) => ({
    url,
    label: `Vidéo ${String(index + 1).padStart(2, '0')}`,
    file: path.split('/').pop() ?? '',
  }));
---

<Layout
  title="Archives intégrales — Red Ball 2026 | Ballroom Strasbourg"
  description="Toutes les photos (170) et vidéos (16) de l'édition précédente Red Light Special — Ballroom Strasbourg."
  htmlLang="fr"
  currentPath="/archives/"
>
  <header class="site-header" id="top">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Ballroom Strasbourg">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Ballroom <em>Strasbourg</em></span>
      </a>

      <nav class="main-nav" aria-label="Navigation">
        <a href="#videos">Vidéos</a>
        <a href="#photos">Photos</a>
        <a href="/red-ball/">Red-Ball</a>
        <a href="/">White-Ball</a>
      </nav>

      <div class="header-actions">
        <a href="/" class="btn btn-ink btn-sm header-cta">White-Ball</a>
      </div>
    </div>
  </header>

  <main>
    <section class="section archives-hero">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow"><span class="crimson-dot" aria-hidden="true"></span> Édition précédente · Red Ball 2026</p>
          <h1>Archives intégrales</h1>
          <p class="section-lead">
            L’ensemble des <strong>{photos.length} photos</strong> et <strong>{videos.length} vidéos</strong> captées lors du Red Light Special Ball avant l’édition White Light.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:22px;">
            <a href="#videos" class="btn btn-outline">Vidéos ({videos.length})</a>
            <a href="#photos" class="btn btn-outline">Photos ({photos.length})</a>
            <a href="/red-ball/" class="btn btn-outline">Site Red-Ball ↗</a>
            <a href="/" class="btn btn-ink">← Retour White-Ball</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="videos">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">01 · Captations</p>
          <h2>Vidéos ({videos.length})</h2>
        </div>

        <div class="videos-grid">
          {
            videos.map((v) => (
              <figure class="video-card">
                <video controls preload="metadata" playsinline>
                  <source src={v.url} type="video/mp4" />
                </video>
                <figcaption class="video-caption">{v.label}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="photos">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">02 · Pellicule complète</p>
          <h2>Photos ({photos.length})</h2>
        </div>

        <div class="full-photos-grid">
          {
            photos.map((p, idx) => (
              <button
                type="button"
                class="full-photo-item"
                data-idx={idx}
                data-full={p.fullSrc}
                aria-label={`Photo ${p.num} sur ${photos.length}`}
              >
                <Image
                  src={p.src}
                  alt={`Red Ball Strasbourg — archive ${p.num}`}
                  width={520}
                  format="webp"
                  loading="lazy"
                />
                <span class="archive-index" aria-hidden="true">
                  {String(p.num).padStart(3, '0')}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <dialog class="archive-dialog" id="archive-dialog" aria-label="Visionneuse">
    <button type="button" class="lightbox-close" id="dlg-close" aria-label="Fermer">✕</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="dlg-prev" aria-label="Précédente">‹</button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" id="dlg-img" alt="" />
      <figcaption class="lightbox-counter" id="dlg-counter"></figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-next" id="dlg-next" aria-label="Suivante">›</button>
  </dialog>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Ballroom <em>Strasbourg</em></span>
          </a>
          <p class="footer-tagline">Archives Red Light Special (2026) · Vers The White Light Special Ball (2027)</p>
        </div>

        <nav class="footer-links" aria-label="Footer">
          <a href="/">White-Ball ↗</a>
          <a href="/red-ball/">Red-Ball ↗</a>
          <a href={TICKET_URL} target="_blank" rel="noopener noreferrer">Billetweb ↗</a>
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        </nav>
      </div>
    </div>
  </footer>

  <style>
    .archives-hero {
      padding-top: clamp(44px, 6vw, 76px);
      padding-bottom: clamp(28px, 4vw, 48px);
    }

    .videos-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .video-card {
      margin: 0;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--line);
      background: #0d0d0e;
    }

    .video-card video {
      display: block;
      width: 100%;
      aspect-ratio: 9 / 16;
      max-height: 460px;
      object-fit: cover;
      background: #000;
    }

    .video-caption {
      padding: 10px 14px;
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.78);
    }

    .full-photos-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .full-photo-item {
      position: relative;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background: var(--bg-soft);
      cursor: pointer;
    }

    .full-photo-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.35s ease;
    }

    .full-photo-item:hover img {
      transform: scale(1.03);
    }

    .archive-dialog {
      width: 100vw;
      height: 100vh;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 32px;
      border: 0;
      background: rgba(14, 14, 15, 0.94);
      color: #fff;
    }

    .archive-dialog[open] {
      display: grid;
      place-items: center;
    }

    @media (max-width: 980px) {
      .videos-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .full-photos-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .videos-grid {
        grid-template-columns: 1fr;
      }
      .full-photos-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }
    }
  </style>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.full-photo-item')];
    const dialog = document.getElementById('archive-dialog') as HTMLDialogElement | null;
    const img = document.getElementById('dlg-img') as HTMLImageElement | null;
    const counter = document.getElementById('dlg-counter');
    let current = 0;

    const show = (index: number) => {
      if (!buttons.length || !img || !counter || !dialog) return;
      current = (index + buttons.length) % buttons.length;
      const btn = buttons[current];
      img.src = btn.dataset.full ?? '';
      img.alt = btn.getAttribute('aria-label') ?? '';
      counter.textContent = `${String(current + 1).padStart(3, '0')} / ${buttons.length}`;
      if (!dialog.open) dialog.showModal();
    };

    buttons.forEach((btn, idx) => btn.addEventListener('click', () => show(idx)));
    document.getElementById('dlg-close')?.addEventListener('click', () => dialog?.close());
    document.getElementById('dlg-prev')?.addEventListener('click', () => show(current - 1));
    document.getElementById('dlg-next')?.addEventListener('click', () => show(current + 1));

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog?.open) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  </script>
</Layout>
