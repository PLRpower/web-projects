  <script>
  let cardIndex = 1;

  function addCard() {
      const container = document.getElementById('cards-container');
      const newCard = document.createElement('div');

      newCard.innerHTML = `
                    <div style="max-width: none; margin: 20px 0" class="split-content contact-form">
                      <div class="card contact-form" style="min-height: inherit">
                        <div id="w-node-_13235370-6615-b8f7-1966-ee3fe42ff50a-73184fd6" class="contact-form-block w-form">
                          <div class="contact-form input-full">
                            <a type="button" onclick="removeCard(this)" style="text-align: right; display: block;">
                              <img src="/img/icons/supprimer.svg" style="width: 20px" alt="supprimer">
                            </a>
                            <div style="display: flex; gap: 10px">
                              <div class="input-wrapper">
                                <label for="front_text_1">Terme</label>
                                <input class="input w-input" type="text" name="cards[0][front_text]" id="front_text_1" required />
                              </div>

                              <div class="input-wrapper">
                                 <label for="back_text_1">Définition</label>
                                 <input class="input w-input" type="text" name="cards[0][back_text]" id="back_text_1" required />
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="card-contact-form-gradient-blur"></div>
                    </div>`;

      container.appendChild(newCard);
      cardIndex++;
  }

  function removeCard(button) {
      const card = button.closest('.split-content');
      card.remove();
  }
  </script>
