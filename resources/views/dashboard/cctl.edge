                  @each((reponse, index) in await question.related('cctlAnswers').query())
                    <div class="input-wrapper input-full">
                      <label for="{{ num_question }}{{ index }}">Votre réponse :</label>
                      <input class="input w-input input-secondary" name="{{ num_question }}{{ index }}" type="number" id="{{ num_question }}{{ index }}" required />
                    </div>
                  @end


                @elseif(question.type == "Question d'association")
