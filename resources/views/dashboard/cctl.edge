                    @if(reponse.texte.slice(-4) == ".png")
                      <div style="display: flex; flex-direction: row; margin-top: 20px">
                        <img src="https://s.elffe.theia.fr/data/platforms/cesi/docimo_image_{{ reponse.texte }}" style="border-radius: 0; width: 50%" alt="Image" />
