@component('layouts/main', { title: 'Créer une catégorie' })
  <div class="py-12 sm:py-16">
    <div class="max-w-2xl mx-auto px-6">
      
      <div class="mb-10">
        <a href="{{ route('admin') }}" class="btn-primary no-hover text-xs mb-3 inline-flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Retour au panneau admin</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Créer un nouvel évènement</h1>
        <p class="text-sm text-[#aaaaaa] mt-1">Ajoutez une nouvelle catégorie pour regrouper les photos d'un évènement.</p>
      </div>

      <div class="bg-[#0f0f0f] border border-[#222222] rounded-2xl p-8 sm:p-10 shadow-2xl">
        <form action="{{ route('category.post') }}" method="POST" enctype="multipart/form-data" class="space-y-6">
          {{ csrfField() }}

          <div>
            <label for="title" class="block text-xs font-bold text-white uppercase tracking-wider mb-2">
              Titre de la catégorie <span class="text-red-400">*</span>
            </label>
            <input type="text" 
                   id="title" 
                   name="title" 
                   required
                   placeholder="Ex: Soirée d'intégration 2026"
                   class="w-full px-4 py-3 rounded-xl bg-[#060606] border border-[#2a2a2a] text-white placeholder-[#555555] focus:outline-none focus:border-white text-sm" />
          </div>

          <div>
            <label for="description" class="block text-xs font-bold text-white uppercase tracking-wider mb-2">
              Description
            </label>
            <textarea id="description" 
                      name="description" 
                      rows="4"
                      placeholder="Quelques mots pour décrire l'évènement..."
                      class="w-full px-4 py-3 rounded-xl bg-[#060606] border border-[#2a2a2a] text-white placeholder-[#555555] focus:outline-none focus:border-white text-sm"></textarea>
          </div>

          <div>
            <label for="thumbnail" class="block text-xs font-bold text-white uppercase tracking-wider mb-2">
              Affiche de couverture <span class="text-red-400">*</span>
            </label>
            <p class="text-xs text-[#777777] mb-3">Format vertical flyer 500x912 (ratio ~9:16). L'image sera automatiquement convertie en WebP.</p>
            <input type="file" 
                   id="thumbnail" 
                   name="thumbnail" 
                   required 
                   accept="image/*"
                   class="w-full text-sm text-[#aaaaaa] file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border file:border-[#2a2a2a] file:bg-[#141414] file:text-white hover:file:bg-[#222222] cursor-pointer" />
          </div>

          <div class="pt-6 border-t border-[#222222] flex items-center justify-end gap-4">
            <a href="{{ route('admin') }}" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-[#aaaaaa] hover:text-white transition-colors">
              Annuler
            </a>
            <button type="submit" 
                    class="px-6 py-2.5 rounded-xl bg-white hover:bg-[#e0e0e0] text-black font-bold text-sm transition-all shadow-md cursor-pointer">
              Créer la catégorie
            </button>
          </div>

        </form>
      </div>

