@component('layouts/main', { title: 'Photos à la une (Accueil)' })
  <div class="py-12 sm:py-16 pb-32"
        x-data="{
          selected: {{ JSON.stringify(medias.filter(m => m.accueil).map(m => m.id)) }},
          toggle(id) {
            const idx = this.selected.indexOf(id);
            if (idx > -1) {
              this.selected.splice(idx, 1);
            } else {
              this.selected.push(id);
            }
          }
        }">
    <div class="max-w-[1360px] mx-auto px-6">
      
      <!-- Header -->
      <div class="pb-8 mb-8 border-b border-[#222222]">
        <a href="{{ route('admin') }}" class="btn-primary no-hover text-xs mb-3 inline-flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Retour au panneau admin</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Photos à la une (Accueil)</h1>
        <p class="text-sm text-[#aaaaaa] mt-1">Cochez les photos que vous souhaitez mettre en avant sur la page d'accueil.</p>
      </div>

      <form action="{{ route('admin.choisir.post') }}" method="POST">
        {{ csrfField() }}

        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
          @each(media in medias)
          <div class="break-inside-avoid relative overflow-hidden border transition-all duration-200 cursor-pointer bg-[#0f0f0f]"
               :class="selected.includes({{ media.id }}) ? 'border-amber-400 ring-2 ring-amber-400/40' : 'border-[#222222] hover:border-[#444444]'"
               @click="toggle({{ media.id }})">
            
            <input type="checkbox" 
                   name="selected_images[]" 
                   value="{{ media.id }}" 
                   :checked="selected.includes({{ media.id }})" 
                   class="hidden" />

            <img src="/uploads/{{ media.id }}.webp" 
                 alt="Photo #{{ media.id }}"
                 loading="lazy" 
                 decoding="async" 
                 class="w-full h-auto select-none block" />

            <!-- Featured star badge -->
            <div class="absolute top-3 right-3 transition-transform"
                 :class="selected.includes({{ media.id }}) ? 'scale-100' : 'scale-90 opacity-40 hover:opacity-100'">
              <div class="w-7 h-7 border flex items-center justify-center shadow-md"
                   :class="selected.includes({{ media.id }}) ? 'bg-amber-400 border-amber-300 text-black font-bold' : 'bg-black/60 border-white/40 text-neutral-400'">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              </div>
            </div>

          </div>
          @endeach
        </div>

        <!-- Sticky save bar -->
        <div class="fixed bottom-6 inset-x-0 z-40 max-w-md mx-auto px-4">
          <div class="bg-[#111111]/95 border border-[#333333] rounded-2xl p-4 shadow-2xl backdrop-blur-md flex items-center justify-between gap-4">
            <div class="text-sm font-bold text-white">
              <span class="text-amber-400 font-extrabold" x-text="selected.length"></span> sélectionnée(s)
            </div>
            <button type="submit" 
                    class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs uppercase tracking-wider transition-all shadow-md cursor-pointer">
              Enregistrer pour l'accueil
            </button>
          </div>
        </div>

      </form>

    </div>
  </div>
@end
