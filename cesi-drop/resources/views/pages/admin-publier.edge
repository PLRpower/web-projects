@component('layouts/main', { title: 'Ajouter des photos (Admin)' })
  <div class="py-12 sm:py-16"
        x-data="{
          categoryId: '',
          dragging: false,
          uploading: false,
          progress: 0,
          success: false,
          errorMsg: null,
          filesCount: 0,
          async handleFiles(files) {
            if (!files || files.length === 0) return;
            this.uploading = true;
            this.progress = 10;
            this.success = false;
            this.errorMsg = null;
            this.filesCount = files.length;

            const formData = new FormData();
            formData.append('category', this.categoryId);
            for (let i = 0; i < files.length; i++) {
              formData.append('files[]', files[i]);
            }

            try {
              const res = await fetch('{{ route('admin.publier.post') }}', {
                method: 'POST',
                headers: {
                  'X-CSRF-TOKEN': '{{ csrfToken }}',
                  'Accept': 'application/json'
                },
                body: formData
              });

              this.progress = 100;
              if (res.ok) {
                this.success = true;
              } else {
                const data = await res.json().catch(() => ({}));
                this.errorMsg = data.message || 'Une erreur est survenue lors de l\'envoi.';
              }
            } catch (e) {
              this.errorMsg = 'Erreur réseau lors du téléversement.';
            } finally {
              this.uploading = false;
            }
          }
        }">
    <div class="max-w-3xl mx-auto px-6">
      
      <div class="mb-10">
        <a href="{{ route('admin') }}" class="btn-primary no-hover text-xs mb-3 inline-flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Retour au panneau admin</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Ajouter des photos directement</h1>
        <p class="text-sm text-[#aaaaaa] mt-1">Les photos téléversées ici seront publiées et directement visibles.</p>
      </div>

      <div class="bg-[#0f0f0f] border border-[#222222] rounded-2xl p-8 sm:p-10 shadow-2xl space-y-6">
        
        <div>
          <label for="category" class="block text-xs font-bold text-white uppercase tracking-wider mb-2">
            Catégorie de destination
          </label>
          <select id="category" 
                  x-model="categoryId"
                  class="w-full px-4 py-3 rounded-xl bg-[#060606] border border-[#2a2a2a] text-white text-sm focus:outline-none focus:border-white">
            <option value="">-- Sans catégorie (uniquement dans la galerie globale) --</option>
            @each(cat in categories)
            <option value="{{ cat.id }}">{{ cat.title }}</option>
            @endeach
          </select>
        </div>

        <div class="border-2 border-dashed rounded-2xl p-8 sm:p-12 text-center transition-all duration-200 cursor-pointer"
             :class="dragging ? 'border-white bg-[#161616]' : 'border-[#333333] hover:border-white bg-[#060606]'"
             @dragover.prevent="dragging = true"
             @dragleave.prevent="dragging = false"
             @drop.prevent="dragging = false; handleFiles($event.dataTransfer.files)"
             @click="$refs.adminFileInput.click()">
          
          <input type="file" 
                 x-ref="adminFileInput" 
                 @change="handleFiles($event.target.files)" 
                 multiple 
                 accept="image/*" 
                 class="hidden" />

          <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-[#141414] border border-[#2a2a2a] flex items-center justify-center text-white">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
            </svg>
          </div>

          <h3 class="text-sm font-bold text-white mb-1">
            Glissez vos photos ou <span class="underline">parcourez vos fichiers</span>
          </h3>
          <p class="text-xs text-[#777777] m-0">Optimisation automatique WebP + sauvegarde HD pour téléchargement</p>
        </div>

        <div x-show="uploading" class="space-y-2" style="display: none;">
          <div class="flex items-center justify-between text-xs text-[#aaaaaa]">
            <span>Traitement et optimisation (<span x-text="filesCount"></span> photos)...</span>
            <span x-text="progress + '%'"></span>
          </div>
          <div class="w-full bg-[#1c1c1c] rounded-full h-1.5 overflow-hidden">
            <div class="bg-white h-1.5 rounded-full transition-all duration-300" :style="`width: ${progress}%`"></div>
          </div>
        </div>

        <div x-show="success" 
             x-transition
             class="p-4 rounded-xl border border-emerald-800/60 bg-emerald-950/30 flex items-center gap-3 text-emerald-300 text-sm"
             style="display: none;">
          <svg class="w-5 h-5 flex-shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <strong>Photos ajoutées !</strong> Vos images ont été publiées et sont directement en ligne.
          </div>
        </div>

        <div x-show="errorMsg" 
             x-transition
             class="p-4 rounded-xl border border-red-800/60 bg-red-950/30 flex items-center gap-3 text-red-300 text-sm"
             style="display: none;">
          <svg class="w-5 h-5 flex-shrink-0 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span x-text="errorMsg"></span>
        </div>

      </div>

    </div>
  </div>
@end
