@component('layouts/main', { title: 'Modération des photos' })
  <div class="py-12 sm:py-16 pb-32"
        x-data="{
          selected: [],
          allIds: {{ JSON.stringify(medias.map(m => m.id)) }},
          allMedias: {{ JSON.stringify(medias.map(m => ({ id: m.id, extname: m.extname }))) }},
          toggle(id) {
            const idx = this.selected.indexOf(id);
            if (idx > -1) {
              this.selected.splice(idx, 1);
            } else {
              this.selected.push(id);
            }
          },
          toggleAll() {
            if (this.selected.length === this.allIds.length) {
              this.selected = [];
            } else {
              this.selected = [...this.allIds];
            }
          }
        }">
    <div class="max-w-[1360px] mx-auto px-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 mb-8 border-b border-[#222222] gap-4">
        <div>
          <a href="{{ route('admin') }}" class="btn-primary no-hover text-xs mb-3 inline-flex items-center gap-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span>Retour au panneau admin</span>
          </a>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">Modérer les photos reçues</h1>
          <p class="text-sm text-[#aaaaaa] mt-1">Sélectionnez les photos à valider, classer ou supprimer.</p>
        </div>
        
        @if(medias && medias.length > 0)
        <div>
          <button type="button" 
                  @click="toggleAll()" 
                  class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-xl bg-[#141414] border border-[#2a2a2a] text-[#aaaaaa] hover:text-white hover:border-[#444444] transition-colors cursor-pointer">
            <span x-text="selected.length === allIds.length ? 'Tout désélectionner' : 'Tout sélectionner'"></span>
          </button>
        </div>
        @endif
      </div>

      @if(!medias || medias.length === 0)
      <div class="text-center py-20 rounded-2xl border border-[#222222] bg-[#0f0f0f] max-w-lg mx-auto p-12">
        <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-emerald-950/30 border border-emerald-800/40 flex items-center justify-center text-emerald-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Aucune photo en attente</h3>
        <p class="text-sm text-[#aaaaaa] m-0">Toutes les photos soumises ont déjà été traitées.</p>
      </div>
      @else

      <form id="moderationForm" action="{{ route('admin.moderer.post') }}" method="POST">
        {{ csrfField() }}

        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
          @each(media in medias)
          <div class="break-inside-avoid relative overflow-hidden border transition-all duration-200 cursor-pointer bg-[#0f0f0f]"
               :class="selected.includes({{ media.id }}) ? 'border-white ring-2 ring-white/50' : 'border-[#222222] hover:border-[#444444]'"
               @click="toggle({{ media.id }})">
            
            <input type="checkbox" 
                   name="selected_images[]" 
                   value="{{ media.id }}" 
                   :checked="selected.includes({{ media.id }})" 
                   class="hidden" />

            <img src="/uploads/{{ media.id }}.webp" 
                 alt="Photo #{{ media.id }}"
                 loading="lazy" 
                 decoding="async" 
                 class="w-full h-auto select-none block" />

            <!-- Selection badge -->
            <div class="absolute top-3 right-3 transition-transform"
                 :class="selected.includes({{ media.id }}) ? 'scale-100' : 'scale-90 opacity-60 hover:opacity-100'">
              <div class="w-6 h-6 border flex items-center justify-center text-xs font-bold shadow-md"
                   :class="selected.includes({{ media.id }}) ? 'bg-white border-white text-black' : 'bg-black/60 border-white/40 text-transparent'">
                &#10003;
              </div>
            </div>

            <!-- Inspect in Lightbox -->
            <button type="button"
                    @click.stop="$dispatch('open-lightbox', { id: {{ media.id }}, ext: '{{ media.extname }}', index: {{ $loop.index }}, items: allMedias })"
                    class="absolute bottom-3 right-3 p-2 bg-black/80 hover:bg-black border border-[#333333] text-white opacity-0 hover:opacity-100 transition-opacity cursor-pointer"
                    title="Agrandir en haute définition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </button>

          </div>
          @endeach
        </div>

        <!-- Sticky action bar at bottom -->
        <div class="fixed bottom-6 inset-x-0 z-40 max-w-xl mx-auto px-4"
             x-show="selected.length > 0"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 translate-y-4"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 translate-y-4"
             style="display: none;">
          
          <div class="bg-[#111111]/95 border border-[#333333] rounded-2xl p-4 shadow-2xl backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <div class="text-sm font-bold text-white flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-lg bg-white text-black text-xs font-bold" x-text="selected.length"></span>
              photo(s) sélectionnée(s)
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto">
              <select name="action" required 
                      class="flex-grow sm:flex-grow-0 px-3 py-2 rounded-xl bg-[#060606] border border-[#333333] text-xs text-white focus:outline-none focus:border-white">
                <optgroup label="Valider et classer">
                  @each(cat in categories)
                  <option value="{{ cat.id }}">Ajouter à "{{ cat.title }}"</option>
                  @endeach
                  <option value="add">Ajouter sans catégorie</option>
                </optgroup>
                <optgroup label="Actions destructives">
                  <option value="remove" class="text-red-400">Supprimer définitivement</option>
                </optgroup>
              </select>

              <button type="submit" 
                      class="px-5 py-2 rounded-xl bg-white text-black hover:bg-[#e0e0e0] font-bold text-xs uppercase tracking-wider transition-all shadow-md whitespace-nowrap cursor-pointer">
                Appliquer
              </button>
            </div>

          </div>
        </div>

      </form>
      @endif

    </div>
  </div>
@end
