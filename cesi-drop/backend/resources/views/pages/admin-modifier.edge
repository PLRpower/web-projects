        <h1 class="display-1" style="font-size: 100px">Modifier une catégorie</h1>
        <div class="inner-container _596px center">
          <p class="mg-bottom-0">Ajouter une nouvelle catégorie pour un nouvel évènement ou série de photos.</p>
        </div>
      </div>
      <div class="inner-container _730px center">
        <div data-w-id="4bae319c-4fb9-2377-7a9c-95b0023eb8ea" style="-webkit-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 10%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="mg-bottom-64px">
          <div class="card form w-form" style="min-height: 200px;">
            <form action="{{ route('admin.modifier.post', [categorie.id]) }}" method="post" enctype="multipart/form-data">
              {{ csrfField() }}
              <input class="input w-password-page w-input" maxlength="256" name="title" data-name="title" type="text" id="title" required="" value="{{ categorie.title }}" />
              <div id="w-node-_4bae319c-4fb9-2377-7a9c-95b0023eb8fe-77d090b4" style="margin-top: 50px">
                <textarea id="description" name="description" maxlength="5000" data-name="description" class="text-area w-input">{{ categorie.description }}</textarea>
              </div>
              <p style="margin-top: 50px;">Thumbnail de la catégorie (de préférence format vertical)</p>
              <p>Ne pas ajouter de photo pour garder la photo actuelle.</p>
              <img src="https://studio-cesi.fr/uploads/categories/{{ categorie.id }}.webp" alt="{{ categorie.title }}" style="max-height: 300px;">
              <input type="file" id="thumbnail" name="thumbnail" data-name="thumbnail">
              <input type="submit" data-wait="Patientez ..." id="w-node-_4bae319c-4fb9-2377-7a9c-95b0023eb902-77d090b4" class="btn-primary w-button" value="Modifier la catégorie" style="margin-top: 50px">
