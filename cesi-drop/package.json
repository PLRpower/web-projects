{
  "name": "cesi-drop-modern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "vite build",
    "dev": "concurrently -n \"SERVER,VITE\" -c \"blue,magenta\" \"node --watch bin/server.js\" \"vite\"",
    "dev:server": "node --watch bin/server.js",
    "dev:vite": "vite",
    "optimize:uploads": "node scripts/optimize-uploads.js"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.0",
    "@adonisjs/core": "^6.6.0",
    "@adonisjs/lucid": "^21.1.1",
    "@adonisjs/session": "^7.4.0",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^2.0.2",
    "@vinejs/vine": "^2.0.0",
    "alpinejs": "^3.14.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "edge.js": "^6.0.2",
    "luxon": "^3.4.4",
    "mysql2": "^3.9.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.4.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.7",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "vite": "^5.2.8"
  }
}
